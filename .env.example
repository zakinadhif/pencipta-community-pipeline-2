# Project-scoped API key for live Responses and Embeddings calls.
OPENAI_API_KEY=your-api-key

# Optional: admin key used only by the "Sync authoritative costs" control.
OPENAI_ADMIN_KEY=your-admin-key

# --- Custom OpenAI-compatible provider (optional) ----------------------------
# When set, the SDK uses this base URL instead of the default OpenAI endpoint.
# Set the real URL in your local .env (this file is a template; .env is ignored).
OPENAI_BASE_URL=

# Model names used by the pipeline stages. Leave empty to use the defaults
# (gpt-5.6-terra / gpt-5.6-luna / text-embedding-3-large).
NEED_MODEL=
JUDGE_MODEL=
INTRODUCTION_MODEL=
EMBEDDING_MODEL=

# Optional per-model pricing (USD per one million tokens) for custom models.
# Format: <input_price>,<output_price>. Cached input follows the input price.
# Leave a model unset and its estimated cost is reported as 0 (never crashes).
# MODEL_PRICE_gpt-4o-mini=0.15,0.60
